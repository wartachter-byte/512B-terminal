     1                                  
     2                                  org 0x7c00
     3                                  bits 16
     4                                  
     5                                  %define SectorsPerTrack 18
     6                                  %define NumberOfHeads 2
     7                                  
     8                                  ; start code for confirmation
     9                                  start:
    10                                  	; Set the stack pointer to the start of our code beacuse it grows downward
    11 00000000 BC007C                  	mov sp, 0x7c00
    12                                  
    13                                  	; also this is at the start cause dl wil contain the boot drive ID
    14                                  	; and idk what all these BIOS calls after this do to dl
    15                                  	; and we modify di later on to
    16 00000003 8816[E400]              	mov [boot_drive], dl
    17                                  
    18                                  	; clears the screen by resetting the videomode. causes flicker, but its smaller
    19                                  	; ah=00h videomode set al=03h, standard videomode
    20 00000007 B80300                  	mov ax, 0003h
    21 0000000A CD10                    	int 0x10
    22                                  
    23                                  	; load the 2 sectors following us. ax = 1, cl = 2, es:bx = 0x0000:0x7e40
    24 0000000C B80100                  	mov ax, 1
    25 0000000F B102                    	mov cl, 2
    26 00000011 BB407E                  	mov bx, 0x7e40
    27 00000014 E87500                  	call load
    28                                  	
    29                                  	; the buffer is after our code so on 0x07d00
    30                                  	; segment = 0x07dxx >>> 0x07d0
    31                                  	; offset = 0, just do xor di, di
    32 00000017 68D007                  	push 0x07d0
    33 0000001A 07                      	pop es
    34 0000001B 31FF                    	xor di, di
    35                                  
    36                                  	; print version
    37 0000001D BE[EC00]                	mov si, msg_vers
    38 00000020 E8AE00                  	call echo
    39                                  	
    40                                  common_start:
    41                                  	; prints '> '	
    42 00000023 BE[E900]                	mov si, msg_start
    43 00000026 E8A800                  	call echo
    44                                  	
    45                                  ;main loop.
    46                                  main:
    47                                  	; Get key.
    48                                  	; Output in AL.
    49 00000029 B400                    	mov ah, 0x00
    50 0000002B CD16                    	int 0x16
    51                                  
    52                                  	
    53                                  	; Check if the user typed a backspace
    54 0000002D 3C08                    	cmp al,8
    55 0000002F 7410                    	je main_backspace
    56                                  
    57                                  	; Check if the user pressed enter
    58                                  	; Also i litteraly forgot i already implented this for a moment
    59 00000031 3C0D                    	cmp al, 13
    60 00000033 7419                    	je run
    61                                  
    62                                  	; check offset of buffer against 63
    63 00000035 83FF3F                  	cmp di, 63
    64                                  	; if bigger or eqaul. so beyond buffer or at the end of it, go back to the main and dont print anything
    65 00000038 73EF                    	jae main
    66                                  
    67                                  	; store the currently typed byte
    68 0000003A AA                      	stosb
    69                                  
    70                                  main_resume:
    71                                  	; Print key.
    72                                  	; Input in AL which lines uo with the Get Key output.
    73 0000003B B40E                    	mov ah, 0x0e
    74 0000003D CD10                    	int 0x10
    75                                  
    76                                  	; Jump back for the loop.
    77 0000003F EBE8                    	jmp main
    78                                  
    79                                  ; just handels the buffers
    80                                  ; modify's di, ah and al
    81                                  ; di - buffer offset
    82                                  main_backspace:
    83                                  
    84                                  	; is the buffer empty?
    85                                  	; if so: just go back
    86 00000041 85FF                    	test di, di
    87 00000043 74E4                    	jz main
    88                                  	
    89                                  	; move the buffer pointer back 1
    90 00000045 4F                      	dec di
    91                                  	; call the echo command for printing
    92                                  	; SI is gonna get the pointer to msg_backspace
    93 00000046 BE[E500]                	mov si, msg_backspace
    94                                  	; call it
    95 00000049 E88500                  	call echo
    96                                  
    97 0000004C EBDB                    	jmp main
    98                                  	
    99                                  	;and now go back to the main loop.
   100                                  
   101                                  run:
   102                                  	; The run command is gonna follow a trie loaded at the start.
   103                                  	; The trie operates like this:
   104                                  	; Byte 1: the character to check with
   105                                  	; Byte 2-3: The pointer to where
   106                                  	; if Byte 1 is a null it means that this defines the end of this layer.
   107                                  	; So if we can't find one, we simply go back to the common_start and move all again
   108                                  	; Now if we find one that points to a null and the current value is a space, then we must load the
   109                                  	; pointer of that thing, because that pointer has the location.
   110                                  
   111                                  	; Plan: Move back the buffer thing, loop: [load, check and keep track of correct]
   112                                  
   113                                  	; move the buffer back to the front which is just setting the offset to zero as the offset
   114                                  	; is mainly used
   115                                  	; Also the offset is SI for lodsb and the segment DS
   116                                  	; now we need (DI >> SI and ES >> DS)
   117 0000004E 89FE                    	mov si, di
   118 00000050 06                      	push es
   119 00000051 1F                      	pop ds
   120                                  	; we can now use some other registers that we will need.
   121                                  	; we will now use ES:DI as our trie pointer
   122                                  	; ES >> 0x07e4	DI >> 0x0000
   123                                  	; set ES
   124 00000052 68E407                  	push 0x07e4
   125 00000055 07                      	pop es
   126                                  	; Clear DI
   127 00000056 31FF                    	xor di, di
   128                                  
   129                                  	; Now that the setup is complete we can start.
   130                                  	; we will need to do losb and then compare against the [ES:DI]
   131                                  	; If it is not correct we dill inc di (if [ES:DI] is zero then we will go to run_z) and try again
   132                                  	; Exception: If AL is 0x20 and [ES:DI] is zero, then we found the last pointer.
   133                                  
   134                                  run_loop:
   135                                  	; load the first byte into AL
   136 00000058 AC                      	lodsb
   137                                  	
   138                                  run_subloop:
   139                                  	; Now compare it.
   140 00000059 263A05                  	cmp al, [es:di]
   141                                  	; not eqaul? try again
   142 0000005C 7506                    	jne run_retry
   143                                  	; is eqaul? go to the next item
   144                                  ; useless label
   145                                  run_next:
   146                                  	; for the next item, we must get the pntr. it will be loaded in little-endian
   147                                  	; so the trie stores it in little-endian to counteract this.
   148                                  	; now it will be based of 0x0000 and so we can use ES:BX
   149                                  	; But to laod it quick, i can use DI to store it in, instanlty loading it
   150                                  	; Also DI must be inc first to load the right spot
   151 0000005E 47                      	inc di
   152 0000005F 268B3D                  	mov di, [es:di]
   153                                  	; we just loaded so we can just jump back
   154 00000062 EBF4                    	jmp run_loop
   155                                  
   156                                  run_retry:
   157                                  	; add DI 3 for the next item
   158 00000064 83C703                  	add di, 3
   159                                  	; Is it zero?
   160 00000067 85FF                    	test di, di
   161                                  	; if so > run_z
   162 00000069 7402                    	jz run_z
   163                                  	; If not: go back to try again
   164 0000006B EBEC                    	jmp run_subloop
   165                                  
   166                                  run_z:
   167                                  	; is AL space (0x20)?
   168 0000006D 3C20                    	cmp al, 0x20
   169                                  	; if it is space: jmp to run_load
   170 0000006F 7402                    	je run_load
   171                                  	; if not: we failed
   172 00000071 EB11                    	jmp run_fail
   173                                  
   174                                  run_load:
   175                                  	; we are currently at ES:DI and this is the spot where we are.
   176                                  	; So we need to get ES:DI + 1 actually
   177 00000073 47                      	inc di
   178 00000074 268B05                  	mov ax, [es:di]
   179                                  	; 1 sector
   180 00000077 B101                    	mov cl, 1
   181                                  	; we are gonna need to put it at 0x7E40 + 1024
   182                                  	; 512 = 0x100, 1024 = 0x200
   183                                  	; 0x7E40 + 0x0200 = 0x8140
   184                                  	; clear es
   185 00000079 6A00                    	push 0
   186 0000007B 07                      	pop es
   187                                  	; put value in BX
   188 0000007C BB4081                  	mov bx, 0x8140
   189                                  	; load it
   190 0000007F E80A00                  	call load
   191                                  	; jmp back
   192 00000082 EB9F                    	jmp common_start
   193                                  
   194                                  run_fail:
   195                                  	; Im just gonna print a error msg ("Unkown command!")
   196                                  	; call the echo command with msg_unkcom
   197 00000084 BE[0301]                	mov si, msg_unkcom
   198 00000087 E84700                  	call echo
   199                                  	; jmp bacl
   200 0000008A EB97                    	jmp common_start
   201                                  
   202                                  ; Loads a sector using LBA
   203                                  ; in:
   204                                  ; 	ax - Sector
   205                                  ;	cl - Count of sectors
   206                                  ; 	es:bx - Where to put
   207                                  ; out:
   208                                  ; 	Putted on memory
   209                                  ; modifications:
   210                                  ; 	None
   211                                  load:
   212                                  	; i want to store the regs passed in so that we dont have any problem
   213                                  	; Start
   214 0000008C 60                      	pusha
   215 0000008D 06                      	push es
   216                                  
   217                                  	; Now i want to calculate the CHS.
   218                                  	; I dont want to recalculate everytime, so im just gonna store it.
   219                                  	; Also save some important regs that will be modified
   220 0000008E 51                      	push cx
   221 0000008F 53                      	push bx
   222                                  	; Now call the conversion
   223 00000090 E82200                  	call load_convert
   224                                  	; Now restore the values into their respective locations (BX, AX (because BIOS))
   225 00000093 5B                      	pop bx
   226 00000094 58                      	pop ax
   227                                  
   228                                  	; now for some final thingy's:
   229                                  	; BIOS call
   230 00000095 B402                    	mov ah, 02h
   231                                  	; 3 times
   232 00000097 BE0300                  	mov si, 3
   233                                  
   234                                  	; and then store it
   235 0000009A 60                      	pusha
   236                                  	; Also push ES beacuse it is not included in pusha but still vital
   237 0000009B 06                      	push es
   238                                  
   239                                  	; now we are ready
   240                                  load_loop:
   241                                  	; clear the carry flag for the BIOS
   242 0000009C F8                      	clc
   243                                  	; now call the BIOS
   244 0000009D CD13                    	int 13h
   245                                  	; did smth went wrong?
   246 0000009F 7202                    	jc load_fail
   247                                   	; no?:
   248                                  
   249 000000A1 EB0D                    	jmp load_complete
   250                                  
   251                                  load_fail:
   252                                  	; reset the drive controller
   253                                  	; ah = 00h
   254 000000A3 30E4                    	xor ah, ah
   255                                  	; int 13h
   256 000000A5 CD13                    	int 13h
   257                                  
   258                                  	; Get the stored setup
   259 000000A7 07                      	pop es
   260 000000A8 61                      	popa
   261                                  
   262                                  
   263                                  	; Now decrement SI for the 3 times
   264 000000A9 4E                      	dec si
   265                                  	; now store the setup again
   266 000000AA 60                      	pusha
   267 000000AB 06                      	push es
   268                                  	
   269                                  	; Is it not yet zero??
   270 000000AC 85F6                    	test si, si
   271                                  	; if so: go back to the loop with the correct things.
   272 000000AE 75EC                    	jnz load_loop
   273                                  
   274                                  	; here it is zero:
   275                                  load_complete:
   276                                  	; Remove the last setup and restore the regs to before the call
   277 000000B0 07                      	pop es
   278 000000B1 61                      	popa
   279                                  	
   280                                  	; End
   281 000000B2 07                      	pop es
   282 000000B3 61                      	popa
   283 000000B4 C3                      	ret
   284                                  	
   285                                  ; converts LBA to CHS
   286                                  ; in:
   287                                  ; 	ax - LBA
   288                                  ; out:
   289                                  ; 	ch - low 8 bits of cylinder
   290                                  ; 	cl =
   291                                  ;		0-5 - sector
   292                                  ;		6-7 - upper 2 bits of cylinder
   293                                  ;	dh - head
   294                                  ; 	dl - drive number
   295                                  ; modifications:
   296                                  ; 	ax, bx, cx, dx
   297                                  load_convert:
   298                                  	; Sector   = (LBA % SPT) + 1
   299                                  	; Head 	   = (LBA / SPT) % NOH
   300                                  	; Cylinder = (LBA / SPT) / NOH
   301                                  
   302                                  	; Plan:
   303                                  	; Calculate (LBA /% SPT), and +1, and /%NOH. lastly move some regs.
   304                                  	
   305                                  	
   306                                  	; clean dx because div uses DX:AX
   307 000000B5 31D2                    	xor dx, dx
   308                                  	; set the value in bx for the div
   309 000000B7 BB1200                  	mov bx, SectorsPerTrack
   310                                  	; divide!
   311 000000BA F7F3                    	div bx
   312                                  
   313                                  	; Calculate the rest of the remainder/Sector.
   314 000000BC 42                      	inc dx
   315                                  	; store the remainder/Sector for later.
   316 000000BD 52                      	push dx
   317                                  
   318                                  	; Now for the head and cylinder
   319                                  	; clean dx because div uses DX:AX
   320 000000BE 31D2                    	xor dx, dx
   321                                  	; set the value in bx for the div
   322 000000C0 BB0200                  	mov bx, NumberOfHeads
   323                                  	; DIVIDE!!!
   324 000000C3 F7F3                    	div bx
   325                                  
   326                                  	; Now DL has the Head, AL the Cylinder, and the Sector is in the stack.
   327                                  	; The Head must be in DH, the Cylinder in CH, and the Sector in CL
   328                                  	; Pop's must be done first, because they operate 16-bit
   329                                  	
   330                                  	; Get the sector. It is in CL now, which is perfect.
   331 000000C5 59                      	pop cx
   332                                  	; Get the drive number. It now is in BL. Im storing it in BX because the head is in DX
   333 000000C6 8A1E[E400]              	mov bl, [boot_drive]
   334                                  
   335                                  	; Now we can do the mov operations.
   336                                  	; Move the Head to DH; Loads a sector using LBA
   337                                  	
   338 000000CA 88D6                    	mov dh, dl
   339                                  	; Move the drive-number to dl
   340 000000CC 88DA                    	mov dl, bl
   341                                  	; Move the Cylinder to CH
   342 000000CE 88C5                    	mov ch, al
   343                                  
   344                                  	; return!!!!!!!!
   345 000000D0 C3                      	ret
   346                                  
   347                                  ; Prints a string till it hits a null.
   348                                  ; in:
   349                                  ; 	00:SI 	- string pointer
   350                                  ; out:
   351                                  ; 	None
   352                                  ; modifications:
   353                                  ; 	None
   354                                  echo:
   355                                  	; AL used to compare
   356                                  	; So im gonna store it all
   357 000000D1 1E                      	push ds
   358 000000D2 50                      	push ax
   359                                  	; clear DS
   360 000000D3 6A00                    	push 0
   361 000000D5 1F                      	pop ds
   362                                  	; Move 0x0E to AH
   363 000000D6 B40E                    	mov ah, 0x0e
   364                                  	; Done with the setup
   365                                  
   366                                  ; Now i need to do it
   367                                  echo_loop:
   368                                  	; Get the byte
   369 000000D8 AC                      	lodsb
   370                                  	; Is it null: > echo_stop
   371 000000D9 84C0                    	test al, al
   372 000000DB 7404                    	jz echo_stop
   373                                  	; It is not null
   374                                  	; so we print it
   375 000000DD CD10                    	int 10h
   376                                  	; now return for the loop
   377 000000DF EBF7                    	jmp echo_loop
   378                                  
   379                                  echo_stop:
   380                                  	; End
   381 000000E1 58                      	pop ax
   382 000000E2 1F                      	pop ds
   383 000000E3 C3                      	ret
   384                                  	
