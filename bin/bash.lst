     1                                  org 0x7c00
     2                                  bits 16
     3                                  
     4                                  %define SectorsPerTrack 18
     5                                  %define NumberOfHeads 2
     6                                  
     7                                  ; start code for confirmation
     8                                  start:
     9                                  	; Set the stack pointer to the start of our code beacuse it grows downward
    10 00000000 BC007C                  	mov sp, 0x7c00
    11                                  
    12                                  	; also this is at the start cause dl wil contain the boot drive ID
    13                                  	; and idk what all these BIOS calls after this do to dl
    14                                  	; and we modify di later on to
    15 00000003 8816[DE00]              	mov [boot_drive], dl
    16                                  
    17                                  	; clears the screen by resetting the videomode. causes flicker, but its smaller
    18                                  	; ah=00h videomode set al=03h, standard videomode
    19 00000007 B80300                  	mov ax, 0003h
    20 0000000A CD10                    	int 0x10
    21                                  
    22                                  	; load the 2 sectors following us. ax = 1, cl = 2, es:bx = 0x0000:0x7e40
    23 0000000C B80100                  	mov ax, 1
    24 0000000F B102                    	mov cl, 2
    25 00000011 BB407E                  	mov bx, 0x7e40
    26 00000014 E86F00                  	call load
    27                                  	
    28                                  	; the buffer is after our code so on 0x07d00
    29                                  	; segment = 0x07dxx >>> 0x07d0
    30                                  	; offset = 0, just do xor di, di
    31 00000017 68D007                  	push 0x07d0
    32 0000001A 07                      	pop es
    33 0000001B 31FF                    	xor di, di
    34                                  
    35                                  common_start:
    36                                  	; prints '> '	
    37 0000001D BE[E300]                	mov si, msg_start
    38 00000020 E8A800                  	call echo
    39                                  	
    40                                  ;main loop.
    41                                  main:
    42                                  	; Get key.
    43                                  	; Output in AL.
    44 00000023 B400                    	mov ah, 0x00
    45 00000025 CD16                    	int 0x16
    46                                  
    47                                  	
    48                                  	; Check if the user typed a backspace
    49 00000027 3C08                    	cmp al,8
    50 00000029 7410                    	je main_backspace
    51                                  
    52                                  	; Check if the user pressed enter
    53                                  	; Also i litteraly forgot i already implented this for a moment
    54 0000002B 3C0D                    	cmp al, 13
    55 0000002D 7419                    	je run
    56                                  
    57                                  	; check offset of buffer against 63
    58 0000002F 83FF3F                  	cmp di, 63
    59                                  	; if bigger or eqaul. so beyond buffer or at the end of it, go back to the main and dont print anything
    60 00000032 73EF                    	jae main
    61                                  
    62                                  	; store the currently typed byte
    63 00000034 AA                      	stosb
    64                                  
    65                                  main_resume:
    66                                  	; Print key.
    67                                  	; Input in AL which lines uo with the Get Key output.
    68 00000035 B40E                    	mov ah, 0x0e
    69 00000037 CD10                    	int 0x10
    70                                  
    71                                  	; Jump back for the loop.
    72 00000039 EBE8                    	jmp main
    73                                  
    74                                  ; just handels the buffers
    75                                  ; modify's di, ah and al
    76                                  ; di - buffer offset
    77                                  main_backspace:
    78                                  
    79                                  	; is the buffer empty?
    80                                  	; if so: just go back
    81 0000003B 85FF                    	test di, di
    82 0000003D 74E4                    	jz main
    83                                  	
    84                                  	; move the buffer pointer back 1
    85 0000003F 4F                      	dec di
    86                                  	; call the echo command for printing
    87                                  	; SI is gonna get the pointer to msg_backspace
    88 00000040 BE[DF00]                	mov si, msg_backspace
    89                                  	; call it
    90 00000043 E88500                  	call echo
    91                                  
    92                                  	
    93                                  	;and now go back to the main loop.
    94 00000046 EBDB                    	jmp main
    95                                  
    96                                  run:
    97                                  	; The run command is gonna follow a trie loaded at the start.
    98                                  	; The trie operates like this:
    99                                  	; Byte 1: the character to check with
   100                                  	; Byte 2-3: The pointer to where
   101                                  	; if Byte 1 is a null it means that this defines the end of this layer.
   102                                  	; So if we can't find one, we simply go back to the common_start and move all again
   103                                  	; Now if we find one that points to a null and the current value is a space, then we must load the
   104                                  	; pointer of that thing, because that pointer has the location.
   105                                  
   106                                  	; Plan: Move back the buffer thing, loop: [load, check and keep track of correct]
   107                                  
   108                                  	; move the buffer back to the front which is just setting the offset to zero as the offset
   109                                  	; is mainly used
   110                                  	; Also the offset is SI for lodsb and the segment DS
   111                                  	; now we need (DI >> SI and ES >> DS)
   112 00000048 89FE                    	mov si, di
   113 0000004A 06                      	push es
   114 0000004B 1F                      	pop ds
   115                                  	; we can now use some other registers that we will need.
   116                                  	; we will now use ES:DI as our trie pointer
   117                                  	; ES >> 0x07e4	DI >> 0x0000
   118                                  	; set ES
   119 0000004C 68E407                  	push 0x07e4
   120 0000004F 07                      	pop es
   121                                  	; Clear DI
   122 00000050 31FF                    	xor di, di
   123                                  
   124                                  	; Now that the setup is complete we can start.
   125                                  	; we will need to do losb and then compare against the [ES:DI]
   126                                  	; If it is not correct we dill inc di (if [ES:DI] is zero then we will go to run_z) and try again
   127                                  	; Exception: If AL is 0x20 and [ES:DI] is zero, then we found the last pointer.
   128                                  
   129                                  run_loop:
   130                                  	; load the first byte into AL
   131 00000052 AC                      	lodsb
   132                                  	
   133                                  run_subloop:
   134                                  	; Now compare it.
   135 00000053 263A05                  	cmp al, [es:di]
   136                                  	; not eqaul? try again
   137 00000056 7506                    	jne run_retry
   138                                  	; is eqaul? go to the next item
   139                                  ; useless label
   140                                  run_next:
   141                                  	; for the next item, we must get the pntr. it will be loaded in little-endian
   142                                  	; so the trie stores it in little-endian to counteract this.
   143                                  	; now it will be based of 0x0000 and so we can use ES:BX
   144                                  	; But to laod it quick, i can use DI to store it in, instanlty loading it
   145                                  	; Also DI must be inc first to load the right spot
   146 00000058 47                      	inc di
   147 00000059 268B3D                  	mov di, [es:di]
   148                                  	; we just loaded so we can just jump back
   149 0000005C EBF4                    	jmp run_loop
   150                                  
   151                                  run_retry:
   152                                  	; add DI 3 for the next item
   153 0000005E 83C703                  	add di, 3
   154                                  	; Is it zero?
   155 00000061 85FF                    	test di, di
   156                                  	; if so > run_z
   157 00000063 7402                    	jz run_z
   158                                  	; If not: go back to try again
   159 00000065 EBEC                    	jmp run_subloop
   160                                  
   161                                  run_z:
   162                                  	; is AL space (0x20)?
   163 00000067 3C20                    	cmp al, 0x20
   164                                  	; if it is space: jmp to run_load
   165 00000069 7402                    	je run_load
   166                                  	; if not: we failed
   167 0000006B EB11                    	jmp run_fail
   168                                  
   169                                  run_load:
   170                                  	; we are currently at ES:DI and this is the spot where we are.
   171                                  	; So we need to get ES:DI + 1 actually
   172 0000006D 47                      	inc di
   173 0000006E 268B05                  	mov ax, [es:di]
   174                                  	; 1 sector
   175 00000071 B101                    	mov cl, 1
   176                                  	; we are gonna need to put it at 0x7E40 + 1024
   177                                  	; 512 = 0x100, 1024 = 0x200
   178                                  	; 0x7E40 + 0x0200 = 0x8140
   179                                  	; clear es
   180 00000073 6A00                    	push 0
   181 00000075 07                      	pop es
   182                                  	; put value in BX
   183 00000076 BB4081                  	mov bx, 0x8140
   184                                  	; load it
   185 00000079 E80A00                  	call load
   186                                  	; jmp back
   187 0000007C EB9F                    	jmp common_start
   188                                  
   189                                  run_fail:
   190                                  	; Im just gonna print a error msg ("Unkown command!")
   191                                  	; call the echo command with msg_unkcom
   192 0000007E BE[E600]                	mov si, msg_unkcom
   193 00000081 E84700                  	call echo
   194                                  	; jmp bacl
   195 00000084 EB97                    	jmp common_start
   196                                  
   197                                  ; Loads a sector using LBA
   198                                  ; in:
   199                                  ; 	ax - Sector
   200                                  ;	cl - Count of sectors
   201                                  ; 	es:bx - Where to put
   202                                  ; out:
   203                                  ; 	Putted on memory
   204                                  ; modifications:
   205                                  ; 	None
   206                                  load:
   207                                  	; i want to store the regs passed in so that we dont have any problem
   208                                  	; Start
   209 00000086 60                      	pusha
   210 00000087 06                      	push es
   211                                  
   212                                  	; Now i want to calculate the CHS.
   213                                  	; I dont want to recalculate everytime, so im just gonna store it.
   214                                  	; Also save some important regs that will be modified
   215 00000088 51                      	push cx
   216 00000089 53                      	push bx
   217                                  	; Now call the conversion
   218 0000008A E82200                  	call load_convert
   219                                  	; Now restore the values into their respective locations (BX, AX (because BIOS))
   220 0000008D 5B                      	pop bx
   221 0000008E 58                      	pop ax
   222                                  
   223                                  	; now for some final thingy's:
   224                                  	; BIOS call
   225 0000008F B402                    	mov ah, 02h
   226                                  	; 3 times
   227 00000091 BE0300                  	mov si, 3
   228                                  
   229                                  	; and then store it
   230 00000094 60                      	pusha
   231                                  	; Also push ES beacuse it is not included in pusha but still vital
   232 00000095 06                      	push es
   233                                  
   234                                  	; now we are ready
   235                                  load_loop:
   236                                  	; clear the carry flag for the BIOS
   237 00000096 F8                      	clc
   238                                  	; now call the BIOS
   239 00000097 CD13                    	int 13h
   240                                  	; did smth went wrong?
   241 00000099 7202                    	jc load_fail
   242                                   	; no?:
   243                                  
   244 0000009B EB0D                    	jmp load_complete
   245                                  
   246                                  load_fail:
   247                                  	; reset the drive controller
   248                                  	; ah = 00h
   249 0000009D 30E4                    	xor ah, ah
   250                                  	; int 13h
   251 0000009F CD13                    	int 13h
   252                                  
   253                                  	; Get the stored setup
   254 000000A1 07                      	pop es
   255 000000A2 61                      	popa
   256                                  
   257                                  
   258                                  	; Now decrement SI for the 3 times
   259 000000A3 4E                      	dec si
   260                                  	; now store the setup again
   261 000000A4 60                      	pusha
   262 000000A5 06                      	push es
   263                                  	
   264                                  	; Is it not yet zero??
   265 000000A6 85F6                    	test si, si
   266                                  	; if so: go back to the loop with the correct things.
   267 000000A8 75EC                    	jnz load_loop
   268                                  
   269                                  	; here it is zero:
   270                                  load_complete:
   271                                  	; Remove the last setup and restore the regs to before the call
   272 000000AA 07                      	pop es
   273 000000AB 61                      	popa
   274                                  	
   275                                  	; End
   276 000000AC 07                      	pop es
   277 000000AD 61                      	popa
   278 000000AE C3                      	ret
   279                                  	
   280                                  ; converts LBA to CHS
   281                                  ; in:
   282                                  ; 	ax - LBA
   283                                  ; out:
   284                                  ; 	ch - low 8 bits of cylinder
   285                                  ; 	cl =
   286                                  ;		0-5 - sector
   287                                  ;		6-7 - upper 2 bits of cylinder
   288                                  ;	dh - head
   289                                  ; 	dl - drive number
   290                                  ; modifications:
   291                                  ; 	ax, bx, cx, dx
   292                                  load_convert:
   293                                  	; Sector   = (LBA % SPT) + 1
   294                                  	; Head 	   = (LBA / SPT) % NOH
   295                                  	; Cylinder = (LBA / SPT) / NOH
   296                                  
   297                                  	; Plan:
   298                                  	; Calculate (LBA /% SPT), and +1, and /%NOH. lastly move some regs.
   299                                  	
   300                                  	
   301                                  	; clean dx because div uses DX:AX
   302 000000AF 31D2                    	xor dx, dx
   303                                  	; set the value in bx for the div
   304 000000B1 BB1200                  	mov bx, SectorsPerTrack
   305                                  	; divide!
   306 000000B4 F7F3                    	div bx
   307                                  
   308                                  	; Calculate the rest of the remainder/Sector.
   309 000000B6 42                      	inc dx
   310                                  	; store the remainder/Sector for later.
   311 000000B7 52                      	push dx
   312                                  
   313                                  	; Now for the head and cylinder
   314                                  	; clean dx because div uses DX:AX
   315 000000B8 31D2                    	xor dx, dx
   316                                  	; set the value in bx for the div
   317 000000BA BB0200                  	mov bx, NumberOfHeads
   318                                  	; DIVIDE!!!
   319 000000BD F7F3                    	div bx
   320                                  
   321                                  	; Now DL has the Head, AL the Cylinder, and the Sector is in the stack.
   322                                  	; The Head must be in DH, the Cylinder in CH, and the Sector in CL
   323                                  	; Pop's must be done first, because they operate 16-bit
   324                                  	
   325                                  	; Get the sector. It is in CL now, which is perfect.
   326 000000BF 59                      	pop cx
   327                                  	; Get the drive number. It now is in BL. Im storing it in BX because the head is in DX
   328 000000C0 8A1E[DE00]              	mov bl, [boot_drive]
   329                                  
   330                                  	; Now we can do the mov operations.
   331                                  	; Move the Head to DH; Loads a sector using LBA
   332                                  	
   333 000000C4 88D6                    	mov dh, dl
   334                                  	; Move the drive-number to dl
   335 000000C6 88DA                    	mov dl, bl
   336                                  	; Move the Cylinder to CH
   337 000000C8 88C5                    	mov ch, al
   338                                  
   339                                  	; return!!!!!!!!
   340 000000CA C3                      	ret
   341                                  
   342                                  ; Prints a string till it hits a null.
   343                                  ; in:
   344                                  ; 	00:SI 	- string pointer
   345                                  ; out:
   346                                  ; 	None
   347                                  ; modifications:
   348                                  ; 	None
   349                                  echo:
   350                                  	; AL used to compare
   351                                  	; So im gonna store it all
   352 000000CB 1E                      	push ds
   353 000000CC 50                      	push ax
   354                                  	; clear DS
   355 000000CD 6A00                    	push 0
   356 000000CF 1F                      	pop ds
   357                                  	; Move 0x0E to AH
   358 000000D0 B40E                    	mov ah, 0x0e
   359                                  	; Done with the setup
   360                                  
   361                                  ; Now i need to do it
   362                                  echo_loop:
   363                                  	; Get the byte
   364 000000D2 AC                      	lodsb
   365                                  	; Is it null: > echo_stop
   366 000000D3 84C0                    	test al, al
   367 000000D5 7404                    	jz echo_stop
   368                                  	; It is not null
   369                                  	; so we print it
   370 000000D7 CD10                    	int 10h
   371                                  	; now return for the loop
   372 000000D9 EBF7                    	jmp echo_loop
   373                                  
   374                                  echo_stop:
   375                                  	; End
   376 000000DB 58                      	pop ax
   377 000000DC 1F                      	pop ds
   378 000000DD C3                      	ret
   379                                  	
