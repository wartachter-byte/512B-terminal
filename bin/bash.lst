   381 000000DE 00                      boot_drive: db 0
   382 000000DF 08200800                msg_backspace: db 8, ' ', 8, 0
   383 000000E3 3E2000                  msg_start: db '> ', 0
   384 000000E6 0D0A556E6B6F776E20-     msg_unkcom: db 13, 10, 'Unkown command!', 13, 10, 0
   384 000000EF 636F6D6D616E64210D-
   384 000000F8 0A00               
   385                                  
   386                                  ; the magic code + PNTR lib
   387 000000FA 00<rep 100h>            times 506-($-$$) db 0
   388                                  ; pntr lib
   389                                  ; 2 + 2 bytes = 4 bytes
   390                                  ; 510 - 4 = 506
   391                                  ; load 
   392 000001FA [8600]                  dw load
   393                                  ; echo
   394 000001FC [CB00]                  dw echo
   395                                  
   396                                  ; the magic code
   397 000001FE 55AA                    dw 0xaa55
