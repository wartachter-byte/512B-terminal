   386 000000E4 00                      boot_drive: db 0
   387 000000E5 08200800                msg_backspace: db 8, ' ', 8, 0
   388 000000E9 3E2000                  msg_start: db  '> ', 0
   389 000000EC 353132422D7465726D-     msg_vers: db '512B-terminal - V0', 13, 10, 13, 10, 0
   389 000000F5 696E616C202D205630-
   389 000000FE 0D0A0D0A00         
   390 00000103 0D0A556E6B6F776E20-     msg_unkcom: db 13, 10, 'Unkown command!', 13, 10, 0
   390 0000010C 636F6D6D616E64210D-
   390 00000115 0A00               
   391                                  
   392                                  ; the magic code + PNTR lib
   393 00000117 00<rep E3h>             times 506-($-$$) db 0
   394                                  ; pntr lib
   395                                  ; 2 + 2 bytes = 4 bytes
   396                                  ; 510 - 4 = 506
   397                                  ; load 
   398 000001FA [8C00]                  dw load
   399                                  ; echo
   400 000001FC [D100]                  dw echo
   401                                  
   402                                  ; the magic code
   403 000001FE 55AA                    dw 0xaa55
